  "customTheme": {
    "description": "Pengguna membuat tema sendiri dari tema dasar. Disimpan lokal sebagai JSON dan disinkronkan lewat /me (tahap backend).",
    "schema": {
      "id": "string unik",
      "name": "string, maks 30 karakter",
      "base": "id salah satu tema bawaan",
      "overrides": "peta peran warna ke hex, boleh: accent, bg, surface, text, bubbleOut, bubbleIn",
      "radius": "0 sampai 28 (sudut gelembung dan kartu)",
      "bubbleShape": "rounded | tail | flat",
      "glass": { "enabled": "boolean", "blur": "0 sampai 40", "opacity": "0.05 sampai 0.80" },
      "wallpaper": { "type": "solid | gradient | image", "stops": "2 sampai 3 hex untuk gradient", "uri": "gambar lokal, dikompres" },
      "font": "id font dari daftar fonts",
      "fontScale": "0.85 sampai 1.30",
      "density": "compact | normal | cozy"
    },
    "guardrails": [
      "Setiap perubahan warna dihitung rasio kontrasnya; teks di bawah 4,5:1 otomatis diperbaiki (onAccent dan text dipilih terang atau gelap) dan pengguna diberi peringatan.",
      "Tombol Reset ke tema dasar selalu tersedia.",
      "Ekspor dan impor tema sebagai berkas JSON (fase berikutnya)."
    ]
  },
  "performance": {
    "glassSetting": "otomatis | hidup | mati",
    "rule": "Efek blur hanya untuk header, bilah input, navigasi bawah, dan modal; tidak pernah per gelembung pesan. Perangkat lemah atau mode hemat daya memakai panelFill tanpa blur."
  },
  "pairs": {
    "solid": [
      ["text", "bg", 4.5], ["text", "surface", 4.5], ["textMuted", "bg", 4.5], ["textMuted", "surface", 4.5],
      ["accent", "surface", 4.5], ["onAccent", "accent", 4.5],
      ["onBubbleOut", "bubbleOut", 4.5], ["timeOut", "bubbleOut", 4.5], ["tickOut", "bubbleOut", 3.0], ["tickReadOut", "bubbleOut", 3.0],
      ["onBubbleIn", "bubbleIn", 4.5], ["textMuted", "bubbleIn", 4.5],
      ["danger", "surface", 4.5], ["success", "surface", 4.5], ["warning", "surface", 4.5],
      ["verified", "surface", 3.0], ["verified", "bg", 3.0], ["borderInput", "surface", 3.0], ["accent", "bg", 3.0]
    ],
    "glass": [
      ["text", "bg", 4.5], ["textMuted", "bg", 4.5], ["text", "panel", 4.5], ["textMuted", "panel", 4.5],
      ["accent", "panel", 4.5], ["onAccent", "accent", 4.5],
      ["onBubbleOut", "bubbleOut", 4.5], ["timeOut", "bubbleOut", 4.5], ["tickOut", "bubbleOut", 3.0], ["tickReadOut", "bubbleOut", 3.0],
      ["onBubbleIn", "panel", 4.5],
      ["danger", "panel", 4.5], ["success", "panel", 4.5], ["warning", "panel", 4.5],
      ["verified", "panel", 3.0], ["borderInput", "panel", 3.0]
    ]
  }
}
