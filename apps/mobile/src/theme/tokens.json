    "plus-jakarta-sans": { "name": "Plus Jakarta Sans", "license": "OFL", "weights": ["400", "500", "700"] },
    "nunito": { "name": "Nunito (bulat)", "license": "OFL", "weights": ["400", "600", "700"] },
    "ibm-plex-sans": { "name": "IBM Plex Sans", "license": "OFL", "weights": ["400", "500", "700"] },
    "lora": { "name": "Lora (serif)", "license": "OFL", "weights": ["400", "500", "700"] },
    "loading": "Font non-sistem diunduh sekali saat dipilih lalu disimpan lokal; hanya bobot di atas."
  },
