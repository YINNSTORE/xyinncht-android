{
  "version": 1,
  "name": "XyinnCht",
  "note": "Nilai warna adalah placeholder merek sampai tahap replica-brand. Nama peran (role) tetap; hanya nilai yang boleh berubah.",
  "scales": {
    "spacing": [4, 8, 12, 16, 20, 24, 32, 40],
    "radius": { "sm": 8, "md": 14, "lg": 20, "xl": 28, "full": 999 },
    "fontSize": { "xs": 12, "sm": 14, "md": 16, "lg": 18, "xl": 22, "xxl": 28 },
    "lineHeight": 1.4,
    "fontWeight": { "regular": "400", "medium": "500", "bold": "700" },
    "motion": { "fast": 120, "base": 200, "slow": 320, "respectReduceMotion": true },
    "layout": { "headerHeight": 56, "inputBarHeight": 56, "bubbleMaxWidthPct": 78, "avatarList": 48, "avatarChat": 32, "touchTargetMin": 44 }
  },
  "fonts": {
    "sistem": { "name": "Sistem", "family": "system", "license": "-", "note": "tanpa unduhan, paling ringan, default" },
